// Buy & hold with a prop evaluation check (hmm-regime-detection-trader, examples/buy_and_hold.py).
// Use on a DAILY chart of MES1! (or another futures contract) with back-adjustment on ("B-ADJ").
//
// Buys at the first session open on or after "Start" and either holds (default) or, in prop mode,
// buys at every 6 PM ET session open and sells at every daily close (flat through each break).
// Costs: $0.62 commission per contract per side plus 1 tick of slippage, as in the Python backtest.
// Holding a back-adjusted chart skips the small cost of rolling each quarter (about $4 per contract).
//
// The evaluation check replays one $50k prop evaluation from the start date: pass at +$3,000,
// fail when the balance falls $2,000 below its highest end-of-day level (the floor stops rising
// once it reaches the starting balance), time out after 250 sessions. The lowest price of each day
// is checked against the floor. Move "Start" to see how much the result depends on when you begin.
//
// From 2020-02-25, the Python backtest had 1 MES buy & hold at +$18,368 with a $6,067 max
// drawdown; replaying an evaluation from every start day, 40% passed (RSI(2) on 2 MES held
// overnight: 57%). Evaluation results for 1 MES held, by start date, to check against:
//   2020-02-25  failed on 2020-03-09 (session 10)    2020-04-01  passed on 2020-06-05 (46)
//   2022-01-03  failed on 2022-01-21 (14)            2023-01-03  passed on 2023-07-13 (133)
//   2024-01-02  passed on 2024-06-18 (117)           2025-01-02  failed on 2025-03-04 (42)
// Backtesting research, not financial advice.

//@version=6
// margin_long = 10: futures need only a margin deposit, not the contracts' full value. With Pine's
// default of 100%, TradingView skips every entry once the contracts are worth more than the
// account ($50k plus profits), which for 2 MES happened from October 2024.
strategy("Buy & Hold (prop check)", shorttitle = "B&H prop", overlay = true,
  initial_capital = 50000, currency = currency.USD,
  default_qty_type = strategy.fixed, default_qty_value = 1,
  commission_type = strategy.commission.cash_per_contract, commission_value = 0.62,
  slippage = 1, pyramiding = 0, process_orders_on_close = false,
  margin_long = 10, margin_short = 10)

// ---------- Inputs ----------
MODE_HOLD = "Hold"
MODE_PROP = "Prop: flat through each daily break"
mode      = input.string(MODE_HOLD, "Mode", options = [MODE_HOLD, MODE_PROP])
qty       = input.int(1, "Contracts", minval = 1)
startTime = input.time(timestamp("2020-02-25T00:00:00"), "Start")
showEval  = input.bool(true, "Show evaluation check", group = "Evaluation")
target    = input.float(3000, "Profit target ($)", minval = 1, group = "Evaluation")
maxDd     = input.float(2000, "Trailing drawdown ($)", minval = 1, group = "Evaluation")
maxDays   = input.int(250, "Sessions allowed", minval = 1, group = "Evaluation")

isProp = mode == MODE_PROP
active = time >= startTime

// ---------- Evaluation check ----------
// Runs before this bar's orders, so a prop-mode position is still open here and its low counts.
var bool   started  = false
var string result   = "waiting for the first fill"
var float  peak     = 0.0
var int    sessions = 0
var bool   done     = false
pnl = strategy.netprofit + strategy.openprofit
if not started and (strategy.position_size != 0 or strategy.closedtrades > 0)
    started := true
    result  := "running"
if started and not done
    sessions += 1
    floorPnl = math.min(peak - maxDd, 0.0)
    // worst point of the day for the position still open at the close (long only)
    worst = pnl - math.max(close - low, 0.0) * syminfo.pointvalue * strategy.position_size
    if worst <= floorPnl or pnl <= floorPnl
        done   := true
        result := "FAILED: hit the trailing drawdown"
    else if pnl >= target
        done   := true
        result := "PASSED"
    else if sessions >= maxDays
        done   := true
        result := "TIMED OUT"
    peak := math.max(peak, pnl)
    if done and showEval
        label.new(bar_index, done and result == "PASSED" ? high : low,
          result + " after " + str.tostring(sessions) + " sessions\nP&L " + str.tostring(pnl, "$#,###"),
          style = result == "PASSED" ? label.style_label_down : label.style_label_up,
          color = result == "PASSED" ? color.new(color.teal, 0) : color.new(color.red, 0), textcolor = color.white)

// ---------- Prices that end the evaluation (hold mode) ----------
// With the position open: the close that reaches the profit target, and the price whose touch
// puts the balance on the trailing-drawdown floor (the floor after today's close).
posValue = syminfo.pointvalue * strategy.position_size
entryPx  = strategy.position_size > 0 ? strategy.opentrades.entry_price(0) : na
live     = not isProp and started and not done and posValue > 0
targetPx = live ? close + (target - pnl) / posValue : na
failPx   = live ? close - (pnl - math.min(peak - maxDd, 0.0)) / posValue : na
plot(showEval ? targetPx : na, "Evaluation passes on a close at or above", color = color.new(#3DDC97, 0), style = plot.style_linebr, linewidth = 2, offset = 1)
plot(showEval ? failPx : na, "Evaluation fails if price touches", color = color.new(#FF6B6B, 0), style = plot.style_linebr, linewidth = 2, offset = 1)

// ---------- Orders ----------
// Market orders placed at a bar's close fill at the next bar's open (the 6 PM ET session open).
if isProp
    if strategy.position_size > 0
        strategy.close_all(comment = "Session close", immediately = true)
    if active
        strategy.entry("Long", strategy.long, qty = qty, comment = "Buy")
else if active and strategy.position_size == 0 and strategy.closedtrades == 0
    strategy.entry("Long", strategy.long, qty = qty, comment = "Buy & hold")

plotFloor = started and not done and showEval
plot(plotFloor ? strategy.initial_capital + math.min(peak - maxDd, 0.0) : na, "Drawdown floor (account $)", color = color.new(color.red, 0), display = display.data_window)
bgcolor(active and not active[1] ? color.new(color.teal, 70) : na, title = "Start")

// ---------- Status panel ----------
// Panel colors: a solid dark panel with light text, readable on light and dark chart themes
PANEL_BG   = #1E222D
PANEL_TEXT = #F0F3FA
PANEL_OK   = #3DDC97
PANEL_BAD  = #FF6B6B
var table panel = table.new(position.top_right, 2, 8, bgcolor = PANEL_BG, frame_color = #434651, frame_width = 1, border_color = #2A2E39, border_width = 1)
// the last confirmed bar: this strategy only runs when a bar closes, so it never sees the open one
if showEval and bar_index >= last_bar_index - 1
    color resColor = result == "PASSED" ? PANEL_OK : str.startswith(result, "FAILED") ? PANEL_BAD : PANEL_TEXT
    table.cell(panel, 0, 0, "Evaluation", text_halign = text.align_left, text_color = PANEL_TEXT)
    table.cell(panel, 1, 0, result, text_color = resColor)
    table.cell(panel, 0, 1, "Sessions", text_halign = text.align_left, text_color = PANEL_TEXT)
    table.cell(panel, 1, 1, str.tostring(sessions) + " of " + str.tostring(maxDays), text_color = PANEL_TEXT)
    table.cell(panel, 0, 2, "Best end-of-day P&L", text_halign = text.align_left, text_color = PANEL_TEXT)
    table.cell(panel, 1, 2, str.tostring(peak, "$#,###"), text_color = PANEL_TEXT)
    table.cell(panel, 0, 3, "P&L now", text_halign = text.align_left, text_color = PANEL_TEXT)
    table.cell(panel, 1, 3, str.tostring(pnl, "$#,###"), text_color = PANEL_TEXT)
    table.cell(panel, 0, 4, "Bought at", text_halign = text.align_left, text_color = PANEL_TEXT)
    table.cell(panel, 1, 4, na(entryPx) ? (isProp ? "each 6 PM ET open" : "-") : str.tostring(entryPx, format.mintick), text_color = PANEL_TEXT)
    table.cell(panel, 0, 5, "Pass (sell) on a close at or above", text_halign = text.align_left, text_color = PANEL_TEXT)
    table.cell(panel, 1, 5, na(targetPx) ? (isProp ? "n/a in prop mode" : "-") : str.tostring(targetPx, format.mintick), text_color = PANEL_OK)
    table.cell(panel, 0, 6, "Fail if price touches", text_halign = text.align_left, text_color = PANEL_TEXT)
    table.cell(panel, 1, 6, na(failPx) ? (isProp ? "n/a in prop mode" : "-") : str.tostring(failPx, format.mintick), text_color = PANEL_BAD)
    table.cell(panel, 0, 7, "Chart", text_halign = text.align_left, text_color = PANEL_TEXT)
    table.cell(panel, 1, 7, timeframe.isdaily ? "daily: OK" : "switch to a 1D chart", text_color = timeframe.isdaily ? PANEL_OK : PANEL_BAD)
