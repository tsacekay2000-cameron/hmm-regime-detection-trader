// RSI(2) pullback, as tested in hmm-regime-detection-trader (examples/mes_mean_reversion.py).
// Use on a DAILY chart of MES1! with back-adjustment on ("B-ADJ" / "Adjust for contract changes").
//
// Rules (Connors, fixed in advance, nothing tuned):
//   - At the daily close, if RSI(2) < 10 and the close is above its 200-day average, go long.
//   - Stay long until the first daily close above the 5-day average.
//
// Modes:
//   - "Prop: flat through each daily break" (default): on each session the rule is long,
//     buy at the session open (6 PM ET) and sell at the daily close, so there is never a
//     position through the 5-6 PM ET break. This is the version that passed ~40% of
//     simulated $50k evaluations at 2 MES (vs ~15% for the same trades with no edge).
//     Each session shows as its own trade in the Strategy Tester.
//   - "Hold overnight": buy at the next session open after the signal, sell at the close
//     of the exit day.
//
// Costs: $0.62 commission per contract per side plus 1 tick of slippage, as in the Python
// backtest. Reference trades: pine/rsi2_mes_reference_trades.csv (python -m examples.rsi2_trade_list).
// Backtesting research, not financial advice.

//@version=6
strategy("RSI(2) Pullback", shorttitle = "RSI2 PB", overlay = true,
  initial_capital = 50000, currency = currency.USD,
  default_qty_type = strategy.fixed, default_qty_value = 2,
  commission_type = strategy.commission.cash_per_contract, commission_value = 0.62,
  slippage = 1, pyramiding = 0, process_orders_on_close = false)

// ---------- Inputs ----------
MODE_PROP = "Prop: flat through each daily break"
MODE_HOLD = "Hold overnight"
mode       = input.string(MODE_PROP, "Mode", options = [MODE_PROP, MODE_HOLD],
  tooltip = "Prop: re-enter at every 6 PM ET open and exit at every daily close while the signal lasts. Hold overnight: one position from the next open to the exit close.")
rsiLen     = input.int(2, "RSI length", minval = 1, group = "Rules")
entryLevel = input.float(10, "Buy when RSI is below", minval = 0, maxval = 100, group = "Rules")
useTrend   = input.bool(true, "Only buy above the trend average", group = "Rules")
trendLen   = input.int(200, "Trend average (days)", minval = 1, group = "Rules")
exitLen    = input.int(5, "Exit average (days)", minval = 1, group = "Rules")
startTime  = input.time(timestamp("2019-01-01T00:00:00"), "Take signals from", group = "Backtest")
showPanel  = input.bool(true, "Show status panel", group = "Display")

isProp = mode == MODE_PROP

// ---------- Signal ----------
r       = ta.rsi(close, rsiLen)
exitMa  = ta.sma(close, exitLen)
trendMa = ta.sma(close, trendLen)
trendOk = not useTrend or (not na(trendMa) and close > trendMa)

// held = long for the NEXT session, decided at this close
var bool held = false
bool wasHeld = held
if wasHeld
    held := not (close > exitMa)
else
    held := not na(r) and r < entryLevel and trendOk and time >= startTime

bool newSignal  = held and not wasHeld
bool exitSignal = wasHeld and not held

// ---------- Orders ----------
// Market orders placed at a bar's close fill at the next bar's open (the 6 PM ET session open);
// immediately = true closes at this bar's close.
if isProp
    if strategy.position_size > 0
        strategy.close_all(comment = "Session close", immediately = true)
    if held
        strategy.entry("Long", strategy.long, comment = newSignal ? "Buy" : "Re-buy")
else
    if strategy.position_size > 0 and not held
        strategy.close("Long", comment = "Exit", immediately = true)
    if held and strategy.position_size == 0
        strategy.entry("Long", strategy.long, comment = "Buy")

// ---------- Plots ----------
plot(useTrend ? trendMa : na, "Trend average", color = color.new(color.gray, 0), linewidth = 2)
plot(exitMa, "Exit average", color = color.new(color.orange, 20))
bgcolor(wasHeld ? color.new(color.teal, 88) : na, title = "Session in trade")
plotshape(newSignal, "Buy signal", shape.triangleup, location.belowbar, color.teal, size = size.small, text = "RSI2")
plotshape(exitSignal, "Exit signal", shape.xcross, location.abovebar, color.orange, size = size.tiny)

// ---------- Status panel ----------
var table panel = table.new(position.top_right, 2, 5, bgcolor = color.new(color.gray, 85), border_width = 1)
if showPanel and barstate.islast
    color ok  = color.new(color.teal, 0)
    color bad = color.new(color.red, 0)
    table.cell(panel, 0, 0, "RSI(" + str.tostring(rsiLen) + ")", text_halign = text.align_left)
    table.cell(panel, 1, 0, str.tostring(r, "#.0") + (r < entryLevel ? "  oversold" : ""), text_color = r < entryLevel ? ok : chart.fg_color)
    table.cell(panel, 0, 1, "Trend filter", text_halign = text.align_left)
    table.cell(panel, 1, 1, not useTrend ? "off" : trendOk ? "above " + str.tostring(trendLen) + "-day" : "below " + str.tostring(trendLen) + "-day", text_color = trendOk ? ok : bad)
    table.cell(panel, 0, 2, "Next session", text_halign = text.align_left)
    string nextTxt = held ? (isProp ? "LONG: buy at 6 PM ET open" : wasHeld ? "LONG: keep holding" : "LONG: buy at next open") : "FLAT"
    table.cell(panel, 1, 2, nextTxt, text_color = held ? ok : chart.fg_color)
    table.cell(panel, 0, 3, "Exit on a close above", text_halign = text.align_left)
    table.cell(panel, 1, 3, held ? str.tostring(exitMa, format.mintick) + " (5-day avg, moves daily)" : "-")
    table.cell(panel, 0, 4, "Chart", text_halign = text.align_left)
    table.cell(panel, 1, 4, timeframe.isdaily ? "daily: OK" : "switch to a 1D chart", text_color = timeframe.isdaily ? ok : bad)

// ---------- Alerts ----------
// Create an alert on this strategy with "alert() function calls only"; each fires once, at the daily close.
if newSignal
    alert("RSI(2) BUY " + syminfo.ticker + ": RSI " + str.tostring(r, "#.0") + ", above the trend average. Buy at the next session open (6 PM ET).", alert.freq_once_per_bar_close)
else if held and isProp
    alert("RSI(2) STILL LONG " + syminfo.ticker + ": buy again at the 6 PM ET open and sell before the daily break.", alert.freq_once_per_bar_close)
if exitSignal
    alert("RSI(2) EXIT " + syminfo.ticker + ": closed above the 5-day average. " + (isProp ? "Do not re-enter at the open." : "Sell."), alert.freq_once_per_bar_close)
