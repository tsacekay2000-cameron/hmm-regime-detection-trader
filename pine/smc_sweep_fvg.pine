// Liquidity sweep + fair value gap, 1R target (hmm-regime-detection-trader, hmm_trader/smc.py).
// Use on a 5-MINUTE chart of MES1! (back-adjustment "B-ADJ" on). Regular hours, US Eastern time.
//
// Setup (long; short mirrors it):
//   1. Liquidity: yesterday's regular-hours low and today's swing lows (a low below the 2 bars on
//      each side, known 2 bars later). A sweep is a bar that trades below an untouched level and
//      closes back above it; every level traded through is used up.
//   2. Within 2-7 bars after the sweep, a bullish fair value gap: this bar's low is above the high
//      of the bar 2 back, the middle (displacement) bar closed up, and its volume was at least 1.5x
//      the average volume at that time of day over the previous 20 full sessions.
//   3. A limit buy at the top of the gap, one tick inside, so it fills only if price trades through
//      the gap's edge, valid for 12 bars (60 minutes) and only from 09:45 to 15:00. It is cancelled
//      if price breaks the stop first.
//   4. Stop one tick below the lowest low since the sweep; target 1x the risk (1R).
//      Size: $200 risk per trade (up to 20 contracts). Everything closed at 16:00.
//   At most one long and one short per day, one position at a time.
//
// Backtest (Python, 2024-10 to 2026-09, MES): 120 trades, 58% won, +0.17R per trade, +$3,001.
// It was the best of 14 variant/market combinations and the same rule made nothing on MNQ, so its
// edge may be luck: paper trade it, do not rely on it. Reference trades to compare:
// pine/smc_1r_mes_reference_trades.csv (python -m examples.smc_backtest --write-trades).
// TradingView fills differ slightly (its limit fills at the order price one tick inside the gap,
// and it may hit the target on the fill bar, which the backtest does not allow).
// Backtesting research, not financial advice.

//@version=6
// margin_long = 10: futures need only a margin deposit, not the contracts' full value.
strategy("Sweep + FVG (1R)", shorttitle = "Sweep FVG", overlay = true,
  initial_capital = 50000, currency = currency.USD,
  commission_type = strategy.commission.cash_per_contract, commission_value = 0.62,
  slippage = 1, pyramiding = 0, process_orders_on_close = false,
  margin_long = 10, margin_short = 10, max_lines_count = 50)

// ---------- Inputs ----------
riskUsd    = input.float(200, "Risk per trade ($)", minval = 1)
targetR    = input.float(1.0, "Target (R multiple)", minval = 0.25, step = 0.25)
minRvol    = input.float(1.5, "Min. relative volume on the displacement bar", minval = 0)
fvgWithin  = input.int(6, "Gap must form within (bars after the sweep)", minval = 1)
fillWithin = input.int(12, "Limit order valid for (bars)", minval = 1)
maxQty     = input.int(20, "Max contracts", minval = 1)
showPanel  = input.bool(true, "Show status panel", group = "Display")
showLevels = input.bool(true, "Show entry, stop and target (latest only)", group = "Display")

// ---------- Session clock (US Eastern, regular hours 09:30-16:00) ----------
TZ    = "America/New_York"
N     = 78
RVOL_DAYS = 20
mins  = hour(time, TZ) * 60 + minute(time, TZ)
idx   = int(math.floor((mins - 570) / 5.0))
is5m  = timeframe.isintraday and timeframe.multiplier == 5
inRth = is5m and mins >= 570 and mins < 960
FIRST = 3    // 09:45 bar
LAST  = 66   // 15:00 bar
tick  = syminfo.mintick
pv    = syminfo.pointvalue

// ---------- Daily state ----------
var float dayHigh = na
var float dayLow  = na
var float prevHigh = na
var float prevLow  = na
var int   barsToday = 0
var array<float> volToday = array.new_float(N, na)
var array<float> volHist  = array.new_float(0)        // last RVOL_DAYS full sessions, N each
var array<float> lowsL  = array.new_float(0)          // untouched levels below (longs)
var array<float> highsS = array.new_float(0)          // untouched levels above (shorts)
var array<int>   swBarL = array.new_int(0)            // open long sweeps: bar index, lowest low since
var array<float> swMinL = array.new_float(0)
var array<int>   swBarS = array.new_int(0)
var array<float> swMaxS = array.new_float(0)
var bool  longDone  = false
var bool  shortDone = false
var int   pendSide  = 0        // pending limit order: +1 long, -1 short, 0 none
var float pendLimit = na
var float pendStop  = na
var float pendTarget = na
var int   pendQty   = 0
var int   pendUntil = na
var float dayStartNet = 0.0
var string lastEvent = "-"

if inRth and idx == 0
    if strategy.position_size != 0  // a shortened session leaves no 16:00 bar
        strategy.close_all(comment = "Session end", immediately = true)
    if barsToday == N              // store yesterday's volumes (full sessions only)
        for k = 0 to N - 1
            array.push(volHist, array.get(volToday, k))
        while array.size(volHist) > RVOL_DAYS * N
            array.shift(volHist)
    prevHigh := dayHigh
    prevLow  := dayLow
    dayHigh  := high
    dayLow   := low
    barsToday := 0
    array.fill(volToday, na)
    array.clear(lowsL)
    array.clear(highsS)
    array.clear(swBarL)
    array.clear(swMinL)
    array.clear(swBarS)
    array.clear(swMaxS)
    if not na(prevLow)
        array.push(lowsL, prevLow)
    if not na(prevHigh)
        array.push(highsS, prevHigh)
    longDone  := false
    shortDone := false
    pendSide  := 0
    strategy.cancel_all()
    dayStartNet := strategy.netprofit
    lastEvent := "-"

relVol(int k, float v) =>
    int days = int(math.floor(array.size(volHist) / N))
    float s = 0.0
    if days > 0
        for d = 0 to days - 1
            s += array.get(volHist, d * N + k)
    days >= RVOL_DAYS and s > 0 ? v / (s / days) : na

string action = ""
if inRth
    barsToday += 1
    dayHigh := math.max(nz(dayHigh, high), high)
    dayLow  := math.min(nz(dayLow, low), low)
    array.set(volToday, idx, volume)
    // keep the lowest low / highest high since each open sweep
    if array.size(swMinL) > 0
        for q = 0 to array.size(swMinL) - 1
            array.set(swMinL, q, math.min(array.get(swMinL, q), low))
    if array.size(swMaxS) > 0
        for q = 0 to array.size(swMaxS) - 1
            array.set(swMaxS, q, math.max(array.get(swMaxS, q), high))

    // swing points confirmed now (formed 2 bars ago, inside today)
    if idx >= 4
        if low[2] < low[3] and low[2] < low[4] and low[2] < low[1] and low[2] < low[0]
            array.push(lowsL, low[2])
        if high[2] > high[3] and high[2] > high[4] and high[2] > high[1] and high[2] > high[0]
            array.push(highsS, high[2])

    // ---- pending order: cancel when expired, stopped before filling, or past 15:00
    if pendSide != 0 and strategy.position_size == 0
        brokeStop = pendSide > 0 ? low < pendStop : high > pendStop
        if bar_index >= pendUntil or idx >= LAST or brokeStop
            strategy.cancel(pendSide > 0 ? "Long" : "Short")
            strategy.cancel(pendSide > 0 ? "Long exit" : "Short exit")
            lastEvent := (pendSide > 0 ? "long" : "short") + " order cancelled" + (brokeStop ? " (stop broke first)" : "")
            pendSide := 0

    // ---- new setups: a fair value gap after an open sweep (checked before new sweeps)
    rv = idx >= 1 ? relVol(idx - 1, volume[1]) : na
    bigVol = minRvol <= 0 or (not na(rv) and rv >= minRvol)
    flat = strategy.position_size == 0 and pendSide == 0
    if flat and idx >= 2 and idx < LAST and bigVol
        // bullish gap: this low above the high 2 bars back, middle bar closed up
        if not longDone and low > high[2] and close[1] > open[1] and array.size(swBarL) > 0
            int pick = -1
            for q = 0 to array.size(swBarL) - 1
                age = bar_index - array.get(swBarL, q)
                if age >= 2 and age <= fvgWithin + 1
                    pick := q
                    break
            if pick >= 0
                stopPx = array.get(swMinL, pick)
                lim = low
                riskPts = lim - stopPx + tick
                n = int(math.min(maxQty, math.floor(riskUsd / (riskPts * pv))))
                if riskPts > tick and n >= 1
                    pendSide := 1
                    pendLimit := lim
                    pendStop := stopPx
                    pendTarget := lim + targetR * (lim - stopPx)
                    pendQty := n
                    pendUntil := bar_index + fillWithin
                    strategy.entry("Long", strategy.long, qty = n, limit = lim - tick)
                    strategy.exit("Long exit", from_entry = "Long", stop = pendStop, limit = pendTarget)
                    action := "LONG LIMIT"
                    array.clear(swBarL)
                    array.clear(swMinL)
        if pendSide == 0 and not shortDone and high < low[2] and close[1] < open[1] and array.size(swBarS) > 0
            int pick = -1
            for q = 0 to array.size(swBarS) - 1
                age = bar_index - array.get(swBarS, q)
                if age >= 2 and age <= fvgWithin + 1
                    pick := q
                    break
            if pick >= 0
                stopPx = array.get(swMaxS, pick)
                lim = high
                riskPts = stopPx - lim + tick
                n = int(math.min(maxQty, math.floor(riskUsd / (riskPts * pv))))
                if riskPts > tick and n >= 1
                    pendSide := -1
                    pendLimit := lim
                    pendStop := stopPx
                    pendTarget := lim - targetR * (stopPx - lim)
                    pendQty := n
                    pendUntil := bar_index + fillWithin
                    strategy.entry("Short", strategy.short, qty = n, limit = lim + tick)
                    strategy.exit("Short exit", from_entry = "Short", stop = pendStop, limit = pendTarget)
                    action := "SHORT LIMIT"
                    array.clear(swBarS)
                    array.clear(swMaxS)

    // ---- sweeps of untouched levels on this bar (levels traded through are used up)
    if action == ""
        float sweptL = na
        if array.size(lowsL) > 0
            for q = array.size(lowsL) - 1 to 0
                lv = array.get(lowsL, q)
                if low < lv
                    if close > lv
                        sweptL := lv
                    array.remove(lowsL, q)
        if not na(sweptL)
            array.push(swBarL, bar_index)
            array.push(swMinL, low)
        float sweptS = na
        if array.size(highsS) > 0
            for q = array.size(highsS) - 1 to 0
                lv = array.get(highsS, q)
                if high > lv
                    if close < lv
                        sweptS := lv
                    array.remove(highsS, q)
        if not na(sweptS)
            array.push(swBarS, bar_index)
            array.push(swMaxS, high)
    // drop sweeps too old to start a setup
    while array.size(swBarL) > 0 and bar_index - array.get(swBarL, 0) > fvgWithin + 1
        array.shift(swBarL)
        array.shift(swMinL)
    while array.size(swBarS) > 0 and bar_index - array.get(swBarS, 0) > fvgWithin + 1
        array.shift(swBarS)
        array.shift(swMaxS)

// fills and exits
if strategy.position_size > 0 and strategy.position_size[1] <= 0
    longDone := true
    pendSide := 0
    lastEvent := "long filled"
if strategy.position_size < 0 and strategy.position_size[1] >= 0
    shortDone := true
    pendSide := 0
    lastEvent := "short filled"
if strategy.position_size == 0 and strategy.position_size[1] != 0
    lastEvent := "position closed"

// close everything at 16:00
if inRth and idx == N - 1
    strategy.cancel_all()
    pendSide := 0
    strategy.close_all(comment = "16:00 close", immediately = true)

// ---------- Alerts (create one with "alert() function calls only") ----------
if action != ""
    alert("SWEEP+FVG " + syminfo.ticker + ": " + action + " " + str.tostring(pendQty) + " at " +
      str.tostring(pendLimit, format.mintick) + " (fills only if traded through), stop " +
      str.tostring(pendStop, format.mintick) + ", target " + str.tostring(pendTarget, format.mintick) +
      ", valid " + str.tostring(fillWithin * 5) + " minutes.", alert.freq_once_per_bar_close)

// ---------- Plots: latest values only, one line each with the price on the axis ----------
bool live = pendSide != 0 or strategy.position_size != 0
plot(showLevels and live ? pendLimit : na, "Entry", color = #F0F3FA, linewidth = 1, trackprice = true, show_last = 1, display = display.pane + display.price_scale)
plot(showLevels and live ? pendStop : na, "Stop", color = #FF6B6B, linewidth = 2, trackprice = true, show_last = 1, display = display.pane + display.price_scale)
plot(showLevels and live ? pendTarget : na, "Target", color = #3DDC97, linewidth = 2, trackprice = true, show_last = 1, display = display.pane + display.price_scale)

// ---------- Status panel ----------
PANEL_BG   = #1E222D
PANEL_TEXT = #F0F3FA
PANEL_OK   = #3DDC97
PANEL_BAD  = #FF6B6B
PANEL_WARN = #FF9F43
var table panel = table.new(position.top_right, 2, 9, bgcolor = PANEL_BG, frame_color = #434651, frame_width = 1, border_color = #2A2E39, border_width = 1)
// the last confirmed bar: this strategy only runs when a bar closes, so it never sees the open one
if showPanel and bar_index >= last_bar_index - 1
    float nearLow = na
    float nearHigh = na
    if array.size(lowsL) > 0
        nearLow := array.max(lowsL)
    if array.size(highsS) > 0
        nearHigh := array.min(highsS)
    int vdays = int(math.floor(array.size(volHist) / N))
    string posTxt = strategy.position_size > 0 ? "LONG " + str.tostring(strategy.position_size) : strategy.position_size < 0 ? "SHORT " + str.tostring(-strategy.position_size) : "FLAT"
    string ordTxt = pendSide == 0 ? "-" : (pendSide > 0 ? "BUY " : "SELL ") + str.tostring(pendQty) + " at " + str.tostring(pendLimit, format.mintick) + " for " + str.tostring(math.max(pendUntil - bar_index, 0) * 5) + " min"
    string sweepTxt = (array.size(swBarL) > 0 ? "low swept (watching for a gap up)" : "") + (array.size(swBarS) > 0 ? (array.size(swBarL) > 0 ? "; " : "") + "high swept (watching for a gap down)" : "")
    float dayPnl = strategy.netprofit - dayStartNet + strategy.openprofit
    table.cell(panel, 0, 0, "Position", text_halign = text.align_left, text_color = PANEL_TEXT)
    table.cell(panel, 1, 0, posTxt, text_color = strategy.position_size > 0 ? PANEL_OK : strategy.position_size < 0 ? PANEL_BAD : PANEL_TEXT)
    table.cell(panel, 0, 1, "Order", text_halign = text.align_left, text_color = PANEL_TEXT)
    table.cell(panel, 1, 1, ordTxt, text_color = pendSide != 0 ? PANEL_WARN : PANEL_TEXT)
    table.cell(panel, 0, 2, "Stop / target", text_halign = text.align_left, text_color = PANEL_TEXT)
    table.cell(panel, 1, 2, live ? str.tostring(pendStop, format.mintick) + " / " + str.tostring(pendTarget, format.mintick) : "-", text_color = PANEL_TEXT)
    table.cell(panel, 0, 3, "Nearest liquidity below / above", text_halign = text.align_left, text_color = PANEL_TEXT)
    table.cell(panel, 1, 3, (na(nearLow) ? "-" : str.tostring(nearLow, format.mintick)) + " / " + (na(nearHigh) ? "-" : str.tostring(nearHigh, format.mintick)), text_color = PANEL_TEXT)
    table.cell(panel, 0, 4, "Sweep", text_halign = text.align_left, text_color = PANEL_TEXT)
    table.cell(panel, 1, 4, sweepTxt == "" ? "none open" : sweepTxt, text_color = sweepTxt == "" ? PANEL_TEXT : PANEL_WARN)
    table.cell(panel, 0, 5, "Last event", text_halign = text.align_left, text_color = PANEL_TEXT)
    table.cell(panel, 1, 5, lastEvent, text_color = PANEL_TEXT)
    table.cell(panel, 0, 6, "Today's P&L", text_halign = text.align_left, text_color = PANEL_TEXT)
    table.cell(panel, 1, 6, str.tostring(dayPnl, "$#,##0"), text_color = dayPnl >= 0 ? PANEL_OK : PANEL_BAD)
    table.cell(panel, 0, 7, "Volume history", text_halign = text.align_left, text_color = PANEL_TEXT)
    table.cell(panel, 1, 7, str.tostring(vdays) + " of " + str.tostring(RVOL_DAYS) + " sessions" + (vdays >= RVOL_DAYS ? "" : " (warming up)"), text_color = vdays >= RVOL_DAYS ? PANEL_OK : PANEL_WARN)
    table.cell(panel, 0, 8, "Chart", text_halign = text.align_left, text_color = PANEL_TEXT)
    table.cell(panel, 1, 8, is5m ? "5-minute: OK" : "switch to a 5-minute chart", text_color = is5m ? PANEL_OK : PANEL_BAD)
