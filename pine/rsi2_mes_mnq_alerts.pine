// RSI(2) pullback: one alert for MES and MNQ together (hmm-regime-detection-trader).
// Add it to any DAILY chart (MES1! is a good choice) and create one alert with
// "Any alert() function call". Each daily close it reports every RSI(2) buy, still-long and
// exit on both symbols, and what to trade under the chosen plan.
//
// Same rules as pine/rsi2_pullback.pine, on back-adjusted daily closes: long after a close with
// RSI(2) < 10 above the 200-day average, out on the first close above the 5-day average.
// Prop version: buy at the 6 PM ET open, sell at the daily close, every session in a trade.
//
// Plans, bootstrap pass rate on a $50k evaluation ($3k target, $2k trailing drawdown, 250
// sessions) vs the same trades with no edge, 2020-2026:
//   2 MES only (default)   39% vs 15%, worst day -$1,450
//   2 MES, else 1 MNQ      37% vs 16%, worst day -$1,450 (sessions with MNQ alone lost money)
//   1 MES + 1 MNQ          35% vs 14%, worst day -$2,392, beyond the $2,000 drawdown
// The two indexes are in a trade together on most of MES's days in a trade, so adding MNQ stacks
// risk more than it adds edge. Backtesting research, not financial advice.

//@version=6
indicator("RSI(2) Pullback: MES + MNQ alerts", shorttitle = "RSI2 MES+MNQ", overlay = false)

PLAN_MES  = "2 MES only (best in backtest)"
PLAN_PREF = "2 MES, else 1 MNQ"
PLAN_BOTH = "1 MES + 1 MNQ"
plan = input.string(PLAN_MES, "Plan", options = [PLAN_MES, PLAN_PREF, PLAN_BOTH],
  tooltip = "Which signals to act on. MNQ signals are always reported; under '2 MES only' they are marked info only.")
symA       = input.symbol("CME_MINI:MES1!", "S&P 500 micro", group = "Symbols")
symB       = input.symbol("CME_MINI:MNQ1!", "Nasdaq-100 micro", group = "Symbols")
rsiLen     = input.int(2, "RSI length", minval = 1, group = "Rules")
entryLevel = input.float(10, "Buy when RSI is below", minval = 0, maxval = 100, group = "Rules")
trendLen   = input.int(200, "Trend average (days)", minval = 1, group = "Rules")
exitLen    = input.int(5, "Exit average (days)", minval = 1, group = "Rules")

// [long for the next session, long for this session, RSI, exit average], decided at each close
rsi2State() =>
    r  = ta.rsi(close, rsiLen)
    ex = ta.sma(close, exitLen)
    tm = ta.sma(close, trendLen)
    var bool held = false
    bool was = held
    if was
        held := not (close > ex)
    else
        held := not na(r) and not na(tm) and r < entryLevel and close > tm
    [held, was, r, ex]

tidA = ticker.modify(symA, backadjustment = backadjustment.on)
tidB = ticker.modify(symB, backadjustment = backadjustment.on)
[hA, wA, rA, eA] = request.security(tidA, "D", rsi2State())
[hB, wB, rB, eB] = request.security(tidB, "D", rsi2State())

// What to trade at the next open under the plan
qtyA   = plan == PLAN_BOTH ? 1 : 2
tradeA = hA
tradeB = plan == PLAN_BOTH ? hB : plan == PLAN_PREF ? hB and not hA : false

statusLine(string name, bool h, bool w, bool trade, int qty, float r) =>
    string s = ""
    if h and not w
        s := name + " BUY signal, RSI " + str.tostring(r, "#.0")
    else if h
        s := name + " still long"
    else if w
        s := name + " EXIT: closed above the 5-day average, do not re-enter"
    if h
        s += trade ? ": buy " + str.tostring(qty) + " " + name + " at the 6 PM ET open" : ": no trade under your plan (info only)"
    s

lineA = statusLine("MES", hA, wA, tradeA, qtyA, rA)
lineB = statusLine("MNQ", hB, wB, tradeB, 1, rB)

// ---------- Alert ----------
if timeframe.isdaily and (lineA != "" or lineB != "")
    string msg = "RSI(2) MES + MNQ (" + plan + ")"
    if lineA != ""
        msg += "\n" + lineA
    if lineB != ""
        msg += "\n" + lineB
    if hA or hB
        msg += "\nSell every open position before the daily break."
    alert(msg, alert.freq_once_per_bar_close)

// ---------- Plots ----------
plot(rA, "MES RSI(2)", color = color.new(color.teal, 0), linewidth = 2)
plot(rB, "MNQ RSI(2)", color = color.new(color.purple, 0))
hline(entryLevel, "Buy level", color = color.new(color.gray, 30), linestyle = hline.style_dashed)
bgcolor(wA ? color.new(color.teal, 85) : wB ? color.new(color.purple, 88) : na, title = "Session in trade")

// ---------- Status panel ----------
var table panel = table.new(position.top_right, 3, 4, bgcolor = color.new(color.gray, 85), border_width = 1)
if barstate.islast
    color ok = color.new(color.teal, 0)
    table.cell(panel, 0, 0, "")
    table.cell(panel, 1, 0, "RSI(2)")
    table.cell(panel, 2, 0, "Next session")
    table.cell(panel, 0, 1, "MES")
    table.cell(panel, 1, 1, str.tostring(rA, "#.0"))
    table.cell(panel, 2, 1, hA ? "LONG " + str.tostring(qtyA) + " MES" : "flat", text_color = hA ? ok : chart.fg_color)
    table.cell(panel, 0, 2, "MNQ")
    table.cell(panel, 1, 2, str.tostring(rB, "#.0"))
    table.cell(panel, 2, 2, hB ? (tradeB ? "LONG 1 MNQ" : "signal, info only") : "flat", text_color = tradeB ? ok : chart.fg_color)
    table.cell(panel, 0, 3, "Chart")
    table.cell(panel, 1, 3, "")
    table.cell(panel, 2, 3, timeframe.isdaily ? "daily: OK" : "switch to a 1D chart", text_color = timeframe.isdaily ? ok : color.red)
